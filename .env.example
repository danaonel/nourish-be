# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# These are loaded automatically at startup (via spring-dotenv), so you do NOT
# need to put them on the `mvn spring-boot:run` command line.

# Enables live Claude coaching/meal planning. Leave unset to use the local planner.
ANTHROPIC_API_KEY=

# --- AWS Cognito auth ---
# Issuer + signing keys are derived from region + user pool id:
#   https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# The defaults in application.yml already point at the nourish pool, so these are
# only needed to override (e.g. a different environment).
COGNITO_ISSUER_URI=https://cognito-idp.us-west-1.amazonaws.com/us-west-1_7xcWXlLGK
COGNITO_JWKS_URI=https://cognito-idp.us-west-1.amazonaws.com/us-west-1_7xcWXlLGK/.well-known/jwks.json
# App client id (NOT a secret). Optional: when set, tokens must carry this client_id.
COGNITO_CLIENT_ID=
# NOTE: never put a Cognito client secret here — the browser PWA is a public
# client and must use an app client with NO secret.

# true (default) enforces JWT auth; false = local dev bypass via X-User-Id header.
SECURITY_ENABLED=true

# Optional overrides:
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# PORT=8080
# FRONTEND_ORIGINS=http://localhost:3000
# MONGODB_URI=mongodb://localhost:27017/nourish   # only used with SPRING_PROFILES_ACTIVE=mongo
